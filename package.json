{
    "name": "noverthinker-admin",
    "version": "1.0.0",
    "description": "NoverThinker Admin Panel - Task library management and content moderation",
    "private": true,
    "type": "module",
    "scripts": {
      "dev": "vite",
      "build": "tsc && vite build",
      "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
