      "@tanstack/react-table": "^8.11.0",
      "axios": "^1.6.5",
      "zustand": "^4.4.7",
      "date-fns": "^3.2.0",
      "recharts": "^2.10.3",
      "lucide-react": "^0.303.0",
      "clsx": "^2.1.0",
      "tailwind-merge": "^2.2.0",
      "@headlessui/react": "^1.7.17",
      "react-hot-toast": "^2.4.1",
      "react-hook-form": "^7.49.2",
